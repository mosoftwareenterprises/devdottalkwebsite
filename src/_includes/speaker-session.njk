{% from "speaker-card.njk" import speakerCard %}

{% macro speakerSession(sessionId, sessionsList) %}
    {% set sessionRecord = null %}
    {# Try to use the helper function if available #}
    {% if sessions is defined and sessions.findById %}
        {% set sessionRecord = sessions.findById(sessionId) %}
    {% elif sessionsList %}
        {# Fallback to manual search in provided list #}
        {% for session in sessionsList %}
            {% if session.id == sessionId %}
                {% set sessionRecord = session %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if not sessionRecord %}
        <p>Session not found.</p>
    {% elif not (sessionRecord | isAllocatedSession) %}
        {% set sessionDate = "" %}
        {% if events is defined and events.all %}
            {% for event in events.all %}
                {% if event.id == sessionRecord.eventID and event.displayDate %}
                    {% set dateParts = event.displayDate.split(" ") %}
                    {% set sessionDate = dateParts[0] ~ " " ~ dateParts[1] %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {% set speakers = [
            { name: sessionRecord.firstSpeakerName, role: sessionRecord.firstSpeakerJobTitle, image: sessionRecord.firstSpeakerBioPicUrl or sessionRecord.firstSpeakerTileImageLocation, url: sessionRecord.firstSpeakerUrl },
            { name: sessionRecord.secondSpeakerName, role: sessionRecord.secondSpeakerJobTitle, image: sessionRecord.secondSpeakerBioPicUrl or sessionRecord.secondSpeakerTileImageLocation, url: sessionRecord.secondSpeakerUrl },
            { name: sessionRecord.thirdSpeakerName, role: sessionRecord.thirdSpeakerJobTitle, image: sessionRecord.thirdSpeakerBioPicUrl or sessionRecord.thirdSpeakerTileImageLocation, url: sessionRecord.thirdSpeakerUrl }
        ] %}
        <div class="speaker-session-cards{% if sessionRecord.thirdSpeakerName %} speaker-session-cards--triple{% elif sessionRecord.secondSpeakerName %} speaker-session-cards--paired{% endif %}">
            {% for speaker in speakers %}
                {% if speaker.name %}
                    {{ speakerCard(sessionDate, sessionRecord.title, speaker.name, speaker.role, speaker.image, speaker.url) }}
                {% endif %}
            {% endfor %}
        </div>
        <div class="speaker-session-copy">
            <h4>{{ sessionRecord.title }}</h4>
            <div class="speaker-session-copy-speakers{% if sessionRecord.secondSpeakerName %} speaker-session-copy-speakers--paired{% endif %}{% if sessionRecord.thirdSpeakerName %} speaker-session-copy-speakers--triple{% endif %}">
                {% for speaker in speakers %}
                    {% if speaker.name %}
                        <div class="speaker-session-copy-speaker">
                            {% if speaker.url %}
                                <h3><a href="{{ speaker.url }}" target="_blank" rel="noopener noreferrer" class="speaker-session-speaker-link">{{ speaker.name }}</a></h3>
                            {% else %}
                                <h3>{{ speaker.name }}</h3>
                            {% endif %}
                            {% if speaker.role %}<strong>{{ speaker.role }}</strong>{% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <p class="formatted-description">{{ sessionRecord.description | markdownInline | safe }}</p>
        </div>
                {# Speaker Bio's #}
                {% if sessionRecord.firstSpeakerBio %}
                    <h5 class="speaker-session-bio-heading">{{ sessionRecord.firstSpeakerName }} Bio</h5>
                    <p class="formatted-description">{{ sessionRecord.firstSpeakerBio }}</p>
                {% endif %}
                {% if sessionRecord.secondSpeakerBio %}
                    <h5 class="speaker-session-bio-heading">{{ sessionRecord.secondSpeakerName }} Bio</h5>
                    <p class="formatted-description">{{ sessionRecord.secondSpeakerBio }}</p>
                {% endif %}
                {% if sessionRecord.thirdSpeakerBio %}
                    <h5 class="speaker-session-bio-heading">{{ sessionRecord.thirdSpeakerName }} Bio</h5>
                    <p class="formatted-description">{{ sessionRecord.thirdSpeakerBio }}</p>
                {% endif %}
            {% endif %}
        {% endmacro %}