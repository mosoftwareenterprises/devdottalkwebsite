{% macro speakerCard(date, title, name, role, image, speakerUrl) %}
  <figure class="event-speaker-card">
    <div class="event-speaker-card-logo" role="img" aria-label="{dev.talk}">
      <span class="event-speaker-card-brace" aria-hidden="true">{</span>
      <span class="event-speaker-card-logo-dev" aria-hidden="true">dev</span>
      <span class="event-speaker-card-logo-dot" aria-hidden="true">.</span>
      <span class="event-speaker-card-logo-talk" aria-hidden="true">talk</span>
      <span class="event-speaker-card-brace" aria-hidden="true">}</span>
    </div>
    {% if date %}<p class="event-speaker-card-date">{{- date }} Speaker</p>{% endif %}
    <p class="event-speaker-card-title">{{ title }}</p>
    <div class="event-speaker-card-photo">
      {% if image %}
        <img src="{{ image }}" alt="{{ name }}" loading="lazy" class="event-speaker-card-portrait">
        {% else %}
          <div class="event-speaker-card-image event-speaker-card-image-placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
      <div class="event-speaker-card-meta">
        <p class="event-speaker-card-name">{% if speakerUrl %}<a href="{{ speakerUrl }}" target="_blank" rel="noopener noreferrer" class="event-speaker-card-name-link">{{ name }}</a>{% else %}{{ name }}{% endif %}</p>
        <p class="event-speaker-card-role">{{ role }}</p>
      </div>
    </figure>
  {% endmacro %}