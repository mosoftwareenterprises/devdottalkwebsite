---
layout: layout
title: "{dev.talk} - Available Speaker Slots"
description: "Dates and session slots still open for accepted {dev.talk} speakers."
permalink: speaker-slots.html
eleventyExcludeFromCollections: true
includeBlueskyPosts: false
includeSpeakerSlotsStyles: true
---

{% set allSessions = sessions.allEvents or [] %}

<section class="speaker-slots">
  <h1 data-speaker-greeting>Thanks for volunteering to speak at {dev.talk}!</h1>
  <p>We're really glad to have you. Have a look at the dates below, pick the one that suits you and press "I want this slot". It should open an email in your email client with your details already filled in, so just review it and hit send.</p>

  <h2>Before you choose</h2>
  <ul class="speaker-slots-help">
    <li><a href="/attending.html">What to expect</a> when you come along</li>
    <li><a href="/code-of-conduct.html">Code of conduct</a></li>
    <li><a href="/previous-events.html">Previous events</a> to get a feel for the evening</li>
    <li><a href="/speakers.html">Meet some of our past speakers</a></li>
    <li><a href="/faqs.html">FAQs</a></li>
  </ul>

  <h2>Available dates</h2>
  <dl class="speaker-slots-who" data-speaker-summary hidden>
    <dt>Speaker</dt>
    <dd data-speaker-name></dd>
    <dt>Session</dt>
    <dd data-speaker-session></dd>
  </dl>

  <ul class="speaker-slots-list">
    {% for ev in events.upcoming | rejectattr('isCancelled') %}
      {% if not ev.isNoEventMonth %}
        {% set assignedSpeakerCount = 0 %}
        {% for sess in allSessions %}
          {% set sessionTitle = (sess.title or "") | trim | lower %}
          {# Lean Coffee is community-led and does not use a speaker slot. #}
          {% if sessionTitle != "lean coffee session" %}
            {% set sessionMatchesEvent = false %}
            {% if ev.sessionIDs is defined and ev.sessionIDs and (sess.id in ev.sessionIDs) %}
              {% set sessionMatchesEvent = true %}
            {% elif sess.eventID is defined and sess.eventID == ev.id %}
              {% set sessionMatchesEvent = true %}
            {% endif %}
            {% if sessionMatchesEvent %}
              {% set firstSpeakerName = (sess.firstSpeakerName or "") | trim | lower %}
              {% if firstSpeakerName and firstSpeakerName != "it could be you!" %}
                {% set assignedSpeakerCount = assignedSpeakerCount + 1 %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% set openSlots = 2 - assignedSpeakerCount %}
        {% if openSlots > 0 %}
          <li class="speaker-slots-item">
            <h2>{{ ev.fullDateLabel }}</h2>
            <p>{{ openSlots }} of 2 session slots available</p>
            {% for n in range(0, openSlots) %}
              <a class="speaker-slots-button" href="mailto:speaker@devdottalk.uk" data-slot-date="{{ ev.fullDateLabel }}">I want this slot</a>
            {% endfor %}
          </li>
        {% endif %}
      {% endif %}
    {% endfor %}
  </ul>
</section>

<script src="/speaker-slots.js"></script>
