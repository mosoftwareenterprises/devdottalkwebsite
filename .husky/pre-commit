#!/bin/bash
# Pre-commit hook: Run format and tests
#
# This hook requires Node 24+ (provided by mise).
# If you encounter errors, run: mise exec -- git commit
# (This ensures the correct Node version is used)
#
# What this does:
# 1. Formats all staged files with Prettier
# 2. Runs full test suite

npx prettier --ignore-unknown --write $(git diff --cached --name-only 2>/dev/null || echo "")
npm run test

